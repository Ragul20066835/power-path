# ============================================================================
# POWERPATH BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# Environment: 'development' | 'production' | 'test'
ENVIRONMENT=production
PORT=8000

# Database Connection (Supabase PostgreSQL Session/Transaction pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase REST API & Service Role (Optional direct integration)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-share

# Security & JWT Authentication
JWT_SECRET=generate-a-secure-random-32-character-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list of trusted frontend URLs)
CORS_ORIGINS=https://powerpath.vercel.app,http://localhost:5173

# Initial Super Admin Bootstrap (Executed on startup if specified)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@powerpath.io
ADMIN_BOOTSTRAP_PASSWORD=your-secure-admin-password-min-12-chars
